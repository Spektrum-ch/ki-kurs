# ============================================
# KI-KURS PLANUNGSWELT – Konfiguration
# Kopiere diese Datei zu .env.local und fülle aus
# ============================================

# JWT Secret (mindestens 32 zufällige Zeichen)
# Generieren mit: openssl rand -base64 32
JWT_SECRET=dein-geheimer-schluessel-mindestens-32-zeichen

# Admin E-Mail (erhält Zugriff auf /admin)
ADMIN_EMAIL=andreas@spekt.ch

# E-Mail via Brevo SMTP (gratis bis 300/Tag)
# Registrierung: https://www.brevo.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=deine@email.ch
SMTP_PASS=dein-brevo-smtp-passwort

# Absender-Adresse
EMAIL_FROM=KI-Kurs Planungswelt <kurs@spekt.ch>

# Basis-URL (ohne Trailing Slash)
NEXT_PUBLIC_BASE_URL=https://kurs.spekt.ch

# Optional: Datenpfad für JSON-Dateien (Standard: ./data)
# DATA_DIR=/var/data/ki-kurs
